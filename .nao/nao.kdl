recipe "default" {
  task "format" description="Format Rust and Markdown" {
    run shell="./t cargo fmt --all && ./t rumdl fmt ."
  }
  task "cargo-fmt" description="Check Rust formatting" {
    run shell="./t cargo fmt --all -- --check"
  }
  task "check-markdown" description="Check Markdown formatting" {
    run shell="./t rumdl check ."
  }
  task "cargo-check" description="Check portable kernel code on the host" {
    run shell="./t cargo check -p byte-ring-kernel-core -p byte-ring-hal -p byte-ring-drivers --features byte-ring-drivers/test-hal,byte-ring-drivers/tcp --all-targets"
  }
  task "cargo-clippy" description="Lint portable kernel code" {
    run shell="./scripts/build-kernel.sh --network --clippy"
  }
  task "cargo-test" description="Run host tests with nextest" {
    run shell="./t cargo-nextest nextest run -p byte-ring-kernel-core -p byte-ring-hal -p byte-ring-drivers --features byte-ring-drivers/test-hal,byte-ring-drivers/tcp"
  }
  task "cargo-doc-test" description="Run Rust documentation tests" {
    run shell="./t cargo test -p byte-ring-kernel-core -p byte-ring-hal -p byte-ring-drivers --features byte-ring-drivers/test-hal,byte-ring-drivers/tcp --doc"
  }
  task "build-kernel" description="Build the freestanding x86_64 kernel ELF" {
    run shell="./scripts/build-kernel.sh"
  }
  task "run" description="Boot QEMU with COM1 output on the host terminal" direct-output=#true {
    depends-on "build-kernel"
    run shell="./scripts/run-qemu.sh"
  }
  task "demo-errors" description="Show CPU fault and panic diagnostics live in QEMU" direct-output=#true {
    run shell="./scripts/demo-errors.sh"
  }
  task "run-net" description="Boot static IPv4 guest on a preconfigured host TAP" direct-output=#true {
    run shell="./scripts/run-network.sh"
  }
  task "network-clippy" description="Lint the native network-enabled kernel" {
    depends-on "net-test"
    run shell="./t clippy clippy -p byte-ring-kernel --features network --target x86_64-unknown-none --release --config 'target.x86_64-unknown-none.rustflags=[\"--sysroot\", \".cache/kernel-sysroot/1.99.0\", \"-C\", \"relocation-model=static\", \"-C\", \"link-arg=-Tcrates/kernel/linker.ld\"]' -- -D warnings"
  }
  task "http-clippy" description="Lint the native HTTP kernel and TCP stack adapter" {
    run shell="./scripts/build-kernel.sh --http --clippy"
  }
  task "net-test" description="Verify virtio-net ARP and static IPv4 ping in QEMU" {
    depends-on "build-kernel"
    run shell="python3 ./scripts/test-network.py"
  }
  task "demo-ping" description="Show static IPv4 ping replies and guest logs" direct-output=#true {
    run shell="python3 ./scripts/test-network.py --demo"
  }
  task "net-wrap-test" description="Exercise virtqueue indices across 65536 packets" {
    run shell="python3 ./scripts/test-network.py --wrap"
  }
  task "check-hal-config" description="Reject host native I/O and bare-metal test HALs" {
    depends-on "build-kernel"
    run shell="./scripts/check-hal-config.sh"
  }
  task "qemu-test" description="Boot the production HAL and verify COM1 output" {
    depends-on "build-kernel"
    run shell="./scripts/test-qemu.sh"
  }
  task "check" description="Run all repository checks" {
    depends-on "cargo-fmt"
    depends-on "check-markdown"
    depends-on "cargo-check"
    depends-on "cargo-clippy"
    depends-on "cargo-test"
    depends-on "cargo-doc-test"
    depends-on "qemu-test"
    depends-on "check-hal-config"
    depends-on "network-clippy"
    depends-on "http-clippy"
    run shell="printf 'Task outcome: repository checks passed\n'"
  }
  task "ci" description="Run continuous integration checks" {
    depends-on "check"
    run shell="printf 'Task outcome: continuous integration checks passed\n'"
  }
}
